# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (local example shown; use MongoDB Atlas for production)
MONGO_URI=mongodb://127.0.0.1:27017/devcollab

# URL of the frontend app, used for CORS + cookie settings
CLIENT_URL=http://localhost:5173

# Runtime environment: development | production | test
NODE_ENV=development

# --- Added in Phase 3 (Authentication) ---
# Use a long, random string in real environments (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Added in Phase 13 (GitHub Integration) ---
# Optional. A GitHub personal access token raises the API rate limit
# from 60/hour to 5,000/hour. The app works fine without it.
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
