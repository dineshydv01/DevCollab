# Frontend Environment Variables Template

# Base URL for the Express API.
# In local development: leave blank or omit (Vite proxies /api to http://localhost:5000)
# In production: set to the full URL of your deployed backend API (including /api)
# Example: https://devcollab-api.onrender.com/api
VITE_API_URL=

# Base URL for the Socket.IO server.
# In local development: leave blank or omit (Vite proxies WebSocket to http://localhost:5000)
# In production: set to the root URL of your deployed backend
# Example: https://devcollab-api.onrender.com
VITE_SOCKET_URL=
